#!/usr/bin/env node

import { program } from 'commander';

// Import the subcommand functions from their files
import { cutCommand } from '../commands/cut.js';
import { trackCommand } from '../commands/track.js';
import { extractAudioCommand } from '../commands/extract-audio.js';
import { safelyTranscriptCommand } from '../commands/transcript.js';
import { compressCommand } from '../commands/compress.js';
import { removeTrackCommand } from '../commands/remove-track.js';
import { compressBatchCommand } from '../commands/compress-batch.js';
import { analyzeCommand } from '../commands/analyze.js';
import { silenceRemoveCommand } from '../commands/silence-remove.js';
import { thumbnailFramesCommand } from '../commands/thumbnail-frames.js';
import { thumbnailCommand } from '../commands/thumbnail.js';
import { obsRenameCommand } from '../commands/obs-renamer.js';
import { joinCommand } from '../commands/join.js';
import { playNotification } from '../lib/notify.js';

function getOutputFile(inputFile, opts, ext = null) {
  if (opts.output) return opts.output;
  const timestamp = new Date().toISOString().replace(/[:.]/g, '-');
  const inputExt = ext || inputFile.split('.').pop();
  return `${inputFile.slice(0, -inputExt.length-1)}_${timestamp}.${inputExt}`;
}

// ---------------------
// Cut
// ---------------------
program
  .command('cut <inputFile>')
  .description('Cut a portion of a video.')
  .option('--from, --start <time>', 'Start time, e.g. 00:01:02')
  .option('--to, --end <time>', 'End time, e.g. 00:02:30')
  .option('-o, --output <outputFile>', 'Output file')
  .action((inputFile, opts) => {
    return cutCommand(inputFile, {
      ...opts,
      output: getOutputFile(inputFile, opts),
    });
  });

// ---------------------
// Track
// ---------------------
program
  .command('track <inputFile>')
  .description('Choose a specific audio track from a video.')
  .requiredOption('--track <trackNumber>', 'Track number (1-based)')
  .option('-o, --output <outputFile>', 'Output file')
  .action((inputFile, opts) => {
    return trackCommand(inputFile, {
      ...opts,
      output: getOutputFile(inputFile, opts),
    });
  });

// ---------------------
// Extract Audio
// ---------------------
program
  .command('extract-audio <inputFile>')
  .description('Extract audio from a video.')
  .option('-o, --output <outputFile>', 'Output file')
  .action((inputFile, opts) => {
    return extractAudioCommand(inputFile, {
      ...opts,
      output: getOutputFile(inputFile, opts, 'wav'),
    });
  });

// ---------------------
// Transcript
// ---------------------
program
  .command('transcript <inputFile>')
  .description('Generate SRT subtitles from video or audio.')
  .option('-o, --output <outputFile>', 'Output file')
  .option('-w, --whisperPath <whisperPath>', 'Whisper path (default: ~/workspace/whisper.cpp)')
  .option('-m, --ggmlModelPath <ggmlModelPath>', 'Ggml model path (default: $GGML_AI_MODELS_PATH/ggml-model-whisper-small.bin)')
  .action((inputFile, opts) => {
    return safelyTranscriptCommand(inputFile, {
      ...opts,
      output: getOutputFile(inputFile, opts, 'srt'),
    });
  });

// ---------------------
// Compress (single file or batch)
// ---------------------
program
  .command('compress <files...>')
  .description('Compress video(s) to a small but reasonable size. Pass multiple files for batch mode.')
  .option('-o, --output <outputFile>', 'Output file (single file only)')
  .option('--verygood', 'Use very good quality result. If false, the quality is good but not VERY good')
  .option('--speed <speed>', 'Specify the speed of compression. Default is fast. "Slow" yields 2x smaller result. Options: fast, slow')
  .option('--codec <codec>', 'Video codec. Options: h264, h265 (default: h265)')
  .action((files, opts) => {
    if (files.length === 1) {
      return compressCommand(files[0], {
        ...opts,
        output: getOutputFile(files[0], opts),
      });
    }
    return compressBatchCommand(files);
  });

// ---------------------
// Remove Track
// ---------------------
program
  .command('remove-track <inputFile>')
  .description('Remove a specific audio track from a video.')
  .requiredOption('--track <trackNumber>', 'Track number (1-based)')
  .option('-o, --output <outputFile>', 'Output file')
  .action((inputFile, opts) => {
    return removeTrackCommand(inputFile, {
      ...opts,
      output: getOutputFile(inputFile, opts),
    });
  });

// ---------------------
// Silence Remove
// ---------------------
program
  .command('silence-remove <inputFile>')
  .description('Remove silent segments from a video.')
  .option('--threshold <dB>', 'Silence threshold (default: -30dB)', '-30dB')
  .option('--duration <seconds>', 'Minimum silence duration in seconds (default: 0.5)', '0.5')
  .option('--min-segment <seconds>', 'Minimum clip duration before merging (default: 3)', '3')
  .option('-o, --output <outputFile>', 'Output file')
  .action((inputFile, opts) => {
    return silenceRemoveCommand(inputFile, {
      ...opts,
      output: getOutputFile(inputFile, opts),
    });
  });

// ---------------------
// Thumbnail Frames (extract raw frames from video)
// ---------------------
program
  .command('thumbnail-frames <inputFile>')
  .description('Extract thumbnail frames from a video.')
  .option('--count <n>', 'Number of thumbnails (default: 5)', '5')
  .option('--interval', 'Use regular intervals instead of scene detection')
  .option('--scene-threshold <0-1>', 'Scene detection threshold (default: 0.3)', '0.3')
  .option('--output-dir <dir>', 'Output directory for thumbnails')
  .action((inputFile, opts) => {
    return thumbnailFramesCommand(inputFile, opts);
  });

// ---------------------
// Thumbnail (styled YouTube thumbnail)
// ---------------------
program
  .command('thumbnail <imageFile>')
  .description('Generate a styled YouTube thumbnail from an image + title.')
  .requiredOption('--title <text>', 'Title text overlay')
  .option('--template <name>', 'Template: bold, side, bottom, or all (default: bold)', 'bold')
  .option('--font <path>', 'Custom TTF font file path')
  .option('-o, --output <file>', 'Output PNG file path')
  .action((imageFile, opts) => {
    return thumbnailCommand(imageFile, opts);
  });

// ---------------------
// Join
// ---------------------
program
  .command('join <files...>')
  .description('Join two or more video files into one.')
  .option('-o, --output <outputFile>', 'Output file')
  .action((files, opts) => {
    return joinCommand(files, {
      ...opts,
      output: opts.output || getOutputFile(files[0], opts),
    });
  });

// ---------------------
// OBS Renamer (macOS only)
// ---------------------
program
  .command('obs-renamer')
  .description('Listen for OBS recordings and rename them via macOS popup dialog. Requires OBS WebSocket, Python 3, and macOS.')
  .option('--install', 'Install as a macOS Launch Agent (auto-start on login)')
  .option('--uninstall', 'Uninstall the macOS Launch Agent')
  .option('--status', 'Check if the Launch Agent is loaded')
  .action((opts) => {
    return obsRenameCommand(opts);
  });

// ---------------------
// Batch (folder-level operations)
// ---------------------
const batch = program
  .command('batch')
  .description('Folder-level batch operations (analyze, compress)');

batch
  .command('analyze <folder>')
  .description('Analyze videos in a folder for compression status')
  .action((folder) => {
    return analyzeCommand(folder).then(results => {
      console.log(results.map(result => result.file).filter(file => !file.isCompressed).join(' '));
    });
  });

batch
  .command('compress <folder>')
  .description('Analyze videos in a folder and auto-compress uncompressed files')
  .action((folder) => {
    return analyzeCommand(folder).then(results => {
      let notCompressedFiles = results
        .filter(result => !result.isCompressed);

      if (notCompressedFiles.length === 0) {
        console.log('No files to compress');
        return;
      }

      // filter files that start with __to_delete-
      notCompressedFiles = notCompressedFiles.filter(result => !result.file.startsWith('__to_delete-'));

      if (notCompressedFiles.length === 0) {
        console.log('Found files to delete, but no files to compress');
        return;
      }

      return compressBatchCommand(
        notCompressedFiles.map(result => `${folder}/${result.file}`)
      );
    });
  });

// Play notification tone after each command completes
program.hook('postAction', async () => {
  await playNotification();
});

// Parse arguments
program.parseAsync(process.argv);
