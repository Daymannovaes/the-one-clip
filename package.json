{
  "name": "oneclip",
  "version": "1.2.0",
  "description": "The One Clip to Rule Them All — a media processing CLI wrapping ffmpeg into ergonomic commands",
  "type": "module",
  "bin": {
    "oneclip": "./bin/oneclip"
  },
  "files": [
    "bin/",
    "commands/",
    "lib/",
    "tones/",
    "README.md"
  ],
  "keywords": [
    "ffmpeg",
    "video",
    "media",
    "cli",
    "compress",
    "cut",
    "transcript",
    "thumbnail"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/daymannovaes/the-one-clip"
  },
  "author": "daymannovaes",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "commander": "^10.0.0",
    "satori": "^0.24.1",
    "sharp": "^0.34.5",
    "zx": "^7.2.0"
  },
  "scripts": {
    "start": "node bin/oneclip",
    "configure": "chmod +x bin/oneclip"
  }
}
